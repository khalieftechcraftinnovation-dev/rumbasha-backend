              "query": [
                { "key": "page", "value": "1", "description": "Halaman, mulai dari 1" },
                { "key": "per_page", "value": "20", "description": "Jumlah data per halaman, maksimal 100" }
              ]
            },
            "description": "Daftar subject dengan pagination. Info halaman ada di `meta`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
