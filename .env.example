# Salin file ini menjadi .env untuk development lokal. Jangan commit file .env.
# development, staging, atau production (data dummy ditolak di production)
APP_ENV=development
APP_PORT=8080

# Alamat publik server (untuk link gambar). Ganti ke domain asli di production, contoh https://api.rumbasha.com
APP_URL=http://localhost:8080

# Folder penyimpanan file upload. Gambar disimpan di STORAGE_DIR/images/<kategori>/<tahun>/<bulan>/
STORAGE_DIR=storage

# Login. JWT_SECRET wajib diisi, minimal 32 karakter acak, dan BERBEDA di setiap server.
# Contoh membuat secret acak di Git Bash: openssl rand -hex 32
JWT_SECRET=
# Masa berlaku access token (sesi login sendiri selalu berakhir tiap tanggal 1, 00:00 WIB)
JWT_ACCESS_TTL=15m

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=rumbasha
DB_SSLMODE=disable

# Database khusus test (data di sini dihapus setiap kali test jalan)
DB_NAME_TEST=rumbasha_test

# true = semua query SQL dicetak di terminal (berguna saat debug)
DB_DEBUG=true

# Aturan Daily Quiz (berlaku sama untuk semua siswa)
# Jatah gratis per hari:
DAILY_QUIZ_FREE_QUOTA=2
# Biaya coin per quiz setelah jatah gratis habis:
DAILY_QUIZ_COIN_COST=10

# Log API: setiap request dicatat ke <LOG_DIR>/api-YYYY-MM-DD.txt (satu file per hari).
# File yang lebih lama dari LOG_RETENTION_DAYS hari dihapus otomatis.
LOG_DIR=logs
LOG_RETENTION_DAYS=15

# Email (SMTP) untuk fitur kirim log ke developer (POST /api/v1/log-reports, khusus admin).
# Kosongkan SMTP_HOST kalau fitur ini tidak dipakai (endpoint akan membalas 503).
# Gmail: SMTP_PASSWORD diisi App Password (16 huruf), bukan password akun Gmail.
#   Buat di https://myaccount.google.com/apppasswords (akun harus memakai verifikasi 2 langkah).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Alamat tujuan laporan bug + file log hari ini
LOG_REPORT_EMAIL=khalieftechcraftinnovation@gmail.com
